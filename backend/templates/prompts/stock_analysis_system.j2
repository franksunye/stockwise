    }
  ],
  "counter_argument": "思维复盘/反向论点：即便目前看多/看空，逻辑失效的触发条件或潜在风险点是什么？",
  "news_analysis": ["相关新闻或公告，若无则写空数组"],
  "tactics": {
    "holding_profit": [ // 已持仓且有盈利
      {
