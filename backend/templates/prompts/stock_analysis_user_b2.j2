{% endfor %}
{% if locale == 'en' -%}
Historical Accuracy: {{ ai_accuracy.total }} times / {{ "%.1f"|format(ai_accuracy.rate) }}%
{% else -%}
历史准确率: {{ ai_accuracy.total }} 次 / {{ "%.1f"|format(ai_accuracy.rate) }}%
{% endif -%}
</ai_prediction_history>
