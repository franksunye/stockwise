#############################################
# StockWise Backend Environment Variables
#############################################

# --- Database ---
# DB_SOURCE=cloud uses Turso; DB_SOURCE=local uses local sqlite
DB_SOURCE=cloud
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# --- Canonical LLM Provider Credentials ---
# Naming convention:
#   LLM_PROVIDER__<PROVIDER_ID>__API_KEY
#   LLM_PROVIDER__<PROVIDER_ID>__BASE_URL
#
# PROVIDER_ID examples (UPPERCASE recommended; case-insensitive in code):
#   ALIYUN_DASHSCOPE       (Aliyun DashScope OpenAI-compatible endpoint)
#   DEEPSEEK_OFFICIAL      (DeepSeek official OpenAI-compatible endpoint)
#   TENCENT_HUNYUAN        (Tencent Hunyuan OpenAI-compatible endpoint)
#   LASTAPI_GEMINI         (last-api Gemini OpenAI-compatible endpoint / proxy)
#
# Notes:
# - Model *selection* lives in DB table `prediction_models`.
# - DB `config_json` should set `provider_id` + `model` (and optionally `base_url` as fallback).

# Aliyun DashScope (can host DeepSeek / Qwen family)
LLM_PROVIDER__ALIYUN_DASHSCOPE__API_KEY=
LLM_PROVIDER__ALIYUN_DASHSCOPE__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek Official
LLM_PROVIDER__DEEPSEEK_OFFICIAL__API_KEY=
LLM_PROVIDER__DEEPSEEK_OFFICIAL__BASE_URL=https://api.deepseek.com/v1

# Tencent Hunyuan (example placeholder)
LLM_PROVIDER__TENCENT_HUNYUAN__API_KEY=
# LLM_PROVIDER__TENCENT_HUNYUAN__BASE_URL=

# last-api Gemini (example placeholder)
LLM_PROVIDER__LASTAPI_GEMINI__API_KEY=
# LLM_PROVIDER__LASTAPI_GEMINI__BASE_URL=

# --- Legacy / Transitional (Optional) ---
# Older configs may still reference these. Prefer the canonical keys above.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER=openai
ALIYUN_API_KEY=
ALIYUN_BASE_URL=
QWEN_API_KEY=
QWEN_VS_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
HUNYUAN_API_KEY=

# --- Ops / Notifications ---
WECOM_ROBOT_KEY=
INTERNAL_API_SECRET=
NEXT_PUBLIC_SITE_URL=https://ziso.cc

