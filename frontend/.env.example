# StockWise Frontend Environment Variables

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Turso) ---
# Server-side only
TURSO_DB_URL=
TURSO_AUTH_TOKEN=
DB_STRATEGY=local
# Fallback support
DB_SOURCE=local
LOCAL_DB_PATH=../data/stockwise.db

# --- Stripe Payments ---
# Server-side
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Client-side
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_YEARLY=

# --- Web Push (VAPID) ---
# Client-side
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-side
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ziso.cc

# --- Auth Secrets ---
# Server-side
INTERNAL_API_SECRET=
ADMIN_API_SECRET=
ADMIN_SESSION_SECRET=
USER_SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Transitional switch: when true, /api/user/register can bind session from legacy client userId.
ALLOW_LEGACY_USERID_BOOTSTRAP=true

# --- Scripts Config (Optional) ---
LOCAL_DB_SYNC_BATCH_SIZE=1000
MANUAL_CHECK_BASE_URL=http://localhost:3000
MANUAL_CHECK_INVITE_USER=
MANUAL_CHECK_WAIT_MS=2000

# --- GitHub Actions (Optional) ---
GITHUB_PAT=
